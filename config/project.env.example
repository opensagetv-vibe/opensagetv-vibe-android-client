# Runtime values used INSIDE the Docker development container.
# Normally configure Android/Fire TV settings in config/firetv.toml in this repository.
SAGETV_ADB_SERIAL=192.168.1.50:5555
SAGETV_DEV_PACKAGE=opensagetv.vibe.miniclient.debug
SAGETV_ARTIFACT_DIR=/workspace/android-client/artifacts/firetv
# SAGETV_AAPT=/opt/android-sdk/build-tools/29.0.2/aapt
# Physical integration tests require explicit local values; no household
# server, SMB credentials, or commissioning paths are stored in Git.
SAGETV_TEST_SERVER=192.0.2.10
SAGETV_UNRAID_HOST=192.0.2.20
SAGETV_TEST_CONTAINER=sagetv-vibe-server-u26-gpu-j11
