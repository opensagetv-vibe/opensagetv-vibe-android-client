+/* Read real decoded metadata BEFORE frame dropping/filtering. MediaCodec does
+ * not enter this function: do not claim its opaque output contains A53 data.
+ * The queue is bounded and abort/OOM paths own/free every allocation. */
+static void vibe_queue_raw_cea(FFPlayer *ffp, const AVFrame *frame)
+{
+    VideoState *is = ffp->is;
+    AVFrameSideData *sd;
+    AVMessage message;
+    VibeCeaPacket *packet;
+    int64_t time_us, start_us;
+    int has_valid = 0;
+    if (!ffp->vibe_raw_cea || !is || frame->pts == AV_NOPTS_VALUE)
+        return;
+    sd = av_frame_get_side_data(frame, AV_FRAME_DATA_A53_CC);
+    if (!sd || sd->size < 3 || sd->size > VIBE_CEA_MAX_BYTES || sd->size % 3)
+        return;
+    for (int i = 0; i < sd->size; i += 3)
+        has_valid |= (sd->data[i] & 4) != 0;
+    if (!has_valid) return;
+    time_us = av_rescale_q(frame->pts, is->video_st->time_base, AV_TIME_BASE_Q);
+    start_us = is->ic->start_time;
+    if (!ffp->no_time_adjust && start_us > 0 && start_us != AV_NOPTS_VALUE)
+        time_us -= start_us;
+    if (time_us < 0) return;
+    SDL_LockMutex(ffp->msg_queue.mutex);
+    if (ffp->msg_queue.abort_request || ffp->msg_queue.nb_messages >= 128) {
+        SDL_UnlockMutex(ffp->msg_queue.mutex);
+        return;
+    }
+    packet = av_mallocz(sizeof(*packet));
+    if (!packet) { SDL_UnlockMutex(ffp->msg_queue.mutex); return; }
+    packet->serial = is->viddec.pkt_serial;
+    packet->time_us = time_us;
+    packet->size = sd->size;
+    memcpy(packet->bytes, sd->data, sd->size);
+    msg_init_msg(&message);
+    message.what = VIBE_CEA_MESSAGE;
+    message.obj = packet;
+    message.free_l = msg_obj_free_l;
+    if (msg_queue_put_private(&ffp->msg_queue, &message) < 0)
+        msg_free_res(&message);
+    SDL_UnlockMutex(ffp->msg_queue.mutex);
+}
