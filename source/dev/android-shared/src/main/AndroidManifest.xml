<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MiniclientApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_v2"
        android:roundIcon="@mipmap/ic_launcher_v2_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.PhoneTheme">
        <meta-data
            android:name="android.max_aspect"
            android:value="2.1" />

        <!-- I don't think this is needed since we are targeting 21+ and it appears to cause crashes -->
        <!--<receiver android:name="android.support.v4.media.session.MediaButtonReceiver">-->
            <!--<intent-filter>-->
                <!--<action android:name="android.intent.action.MEDIA_BUTTON" />-->
                <!--&lt;!&ndash;<action android:name="android.media.AUDIO_BECOMING_NOISY" />&ndash;&gt;-->
            <!--</intent-filter>-->
        <!--</receiver>-->

        <service
            android:name=".MiniclientService"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".gdx.MiniClientGDXActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:finishOnTaskLaunch="false"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:launchMode="standard"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".opengl.MiniClientOpenGLActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:finishOnTaskLaunch="false"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:launchMode="standard"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.PlaybackTrackSettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.PhoneTheme" />
        <activity
            android:name=".ui.settings.HomeBackgroundSettingsActivity"
            android:exported="false"
            android:label="@string/background_session_settings_title"
            android:theme="@style/Theme.PhoneTheme" />
        <activity
            android:name=".ui.settings.DiscPlaybackSettingsActivity"
            android:exported="false"
            android:label="@string/disc_playback_settings_title"
            android:theme="@style/Theme.PhoneTheme" />
        <activity
            android:name=".connect.ConnectingActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/title_activity_connecting"
            android:theme="@style/FullscreenTheme"></activity>
        <activity
            android:name=".ui.settings.TouchMappingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.MediaMappingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.SmbProfileSettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.FixedTranscodingActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.FixedRemuxingActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.ExoPlayerSettingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.Media3PlayerSettingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.IJKPlayerSettingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.GSYPlayerSettingsActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
        <activity
            android:name=".ui.settings.CodecContainerActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme"></activity>
    </application>

</manifest>
