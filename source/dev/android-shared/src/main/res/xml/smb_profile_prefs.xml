<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="SMB Direct playback">
        <EditTextPreference
            android:key="smb_direct/mappings"
            android:title="@string/smb_mappings_title"
            android:summary="@string/smb_mappings_summary"
            android:inputType="textMultiLine|textNoSuggestions" />
        <EditTextPreference
            android:key="smb_direct/username"
            android:title="@string/smb_username_title"
            android:summary="@string/smb_username_summary"
            android:inputType="textNoSuggestions" />
        <EditTextPreference
            android:key="smb_direct/password"
            android:title="@string/smb_password_title"
            android:summary="@string/smb_password_summary"
            android:inputType="textPassword" />
        <EditTextPreference
            android:key="smb_direct/domain"
            android:title="@string/smb_domain_title"
            android:summary="@string/smb_domain_summary"
            android:inputType="textCapCharacters|textNoSuggestions" />
        <EditTextPreference
            android:key="smb_direct/read_ahead_kb"
            android:defaultValue="256"
            android:title="SMB read-ahead (KiB)"
            android:summary="Batches small player reads; valid range 32-8192 KiB"
            android:inputType="number" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Configuration share">
        <EditTextPreference
            android:key="smb_profiles/directory"
            android:defaultValue=""
            android:title="SMB configuration directory"
            android:summary="SMB2/SMB3 directory containing named MiniClient profiles, for example smb://nas/media/config/" />
        <EditTextPreference
            android:key="smb_profiles/auth/username"
            android:title="Configuration share username"
            android:summary="Leave blank for guest/public access" />
        <EditTextPreference
            android:key="smb_profiles/auth/password"
            android:title="Configuration share password"
            android:summary="Stored only on this device; never exported in profiles"
            android:inputType="textPassword" />
        <EditTextPreference
            android:key="smb_profiles/auth/domain"
            android:title="Configuration share domain"
            android:summary="Optional SMB authentication domain" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Named profiles">
        <Preference
            android:key="smb_profiles/refresh"
            android:title="Refresh profile list"
            android:summary="Read available .profile files from the configuration share" />
        <ListPreference
            android:key="smb_profiles/selected"
            android:title="Profile to import"
            android:summary="Refresh to list remote profiles" />
        <EditTextPreference
            android:key="smb_profiles/name"
            android:title="Profile name to save"
            android:summary="1-64 letters, numbers, dot, underscore, or dash" />
        <Preference
            android:key="smb_profiles/save"
            android:title="Save this client's settings"
            android:summary="Credentials are never written to the profile" />
        <Preference
            android:key="smb_profiles/load"
            android:title="Import selected profile"
            android:summary="Keeps this device's Client ID unless separately approved" />
    </PreferenceCategory>
</PreferenceScreen>
