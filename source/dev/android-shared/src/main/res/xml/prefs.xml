<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/playback" android:title="Playback Settings">
<ListPreference
            android:defaultValue="exoplayer"
            android:dialogTitle="@string/dialog_title_default_player"
            android:entries="@array/entries_list_default_player"
            android:entryValues="@array/entryvalues_list_default_player"
            android:key="default_player"
            android:summary="@string/summary_list_default_player"
            android:title="@string/title_list_default_player"/>
<Preference android:key="selected_player_settings" android:title="Selected Player Settings"/>
<Preference android:key="playback_defaults_settings" android:title="Video Filters and Display Settings"/>
<ListPreference
            android:defaultValue="hardware"
            android:dialogTitle="@string/dialog_title_decoding_method"
            android:entries="@array/entries_list_decoding_method"
            android:entryValues="@array/entryvalues_list_decoding_method"
            android:key="decoding_method"
            android:summary="@string/summary_list_decoding_method"
            android:title="@string/title_list_decoding_method"/>
<ListPreference
            android:defaultValue="auto"
            android:key="video_deinterlace_mode"
            android:title="Player Deinterlace"
            android:dialogTitle="Deinterlace"
            android:entries="@array/entries_video_deinterlace_mode"
            android:entryValues="@array/entryvalues_video_deinterlace_mode" />
<CheckBoxPreference
            android:defaultValue="true"
            android:key="use_opengl_ui"
            android:summary="@string/use_opengl_ui_summary"
            android:title="@string/use_opengl_ui_title" />
<CheckBoxPreference
            android:defaultValue="true"
            android:key="use_native_resolution"
            android:summary="@string/use_native_resolution_summary"
            android:title="@string/use_native_resolution_title"/>
<CheckBoxPreference
            android:defaultValue="false"
            android:key="wait_for_playback_before_first_osd"
            android:summary="@string/wait_for_playback_before_first_osd_summary"
            android:title="@string/wait_for_playback_before_first_osd_title" />
<Preference
            android:key="playback_track_settings"
            android:summary="Audio languages, broadcast CC services, and separate SRT/DVD subtitle language"
            android:title="Audio, Broadcast CC, and Subtitle Settings" />
<Preference
            android:key="disc_playback_settings"
            android:summary="DVD menus, main-feature and preview policy, playback path, and compatibility fallback"
            android:title="Disc and DVD Playback Settings" />
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>

    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/transport" android:title="Transport Settings">
<ListPreference
            android:defaultValue="dynamic"
            android:dialogTitle="Transport Method"
            android:entries="@array/entries_list_streaming_mode_preference"
            android:entryValues="@array/entryvalues_list_streaming_mode_preference"
            android:key="streaming_mode"
            android:summary="@string/summary_list_streaming_mode_preference"
            android:title="Transport Method"/>
<Preference android:key="push_settings" android:title="Push Settings"/>
<Preference android:title="Fixed Playback Settings"
            android:summary="Change the setting SageTV server will use to transcode content when using fixed streaming"
            android:key="fixed_transcoding"/>
<Preference
            android:key="smb_settings"
            android:title="SMB Direct Settings"
            android:summary="Playback mappings, credentials, read-ahead, and shared configuration profiles" />
<ListPreference android:key="playback_buffer_preset" android:title="Source Buffering" android:defaultValue="balanced"
    android:entries="@array/entries_playback_buffer_preset" android:entryValues="@array/values_playback_buffer_preset"
    android:summary="%s"/>
<PreferenceCategory android:title="Advanced Compatibility" android:key="transport/advanced"><Preference android:title="Codec and Container Settings"
            android:summary="Change how the application reports to SageTV which containers and codecs it supports. This can be helpful if a specific device does not handle a specific codec or container well"
            android:key="container_codec_settings"/><CheckBoxPreference
            android:defaultValue="true"
            android:key="unified_graphics_surfaces"
            android:summary="@string/unified_graphics_surfaces_summary"
            android:title="@string/unified_graphics_surfaces_title" /></PreferenceCategory>
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>

    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/mappings" android:title="Mappings">
<Preference android:title="Media Key Mappings"
            android:summary="Change the default mappings for remote controls and game pads"
            android:key="media_key_mappings"/>
<Preference android:title="Touch Mappings"
            android:summary="Change the default mappings touch screen actions"
            android:key="touch_mappings"/>
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>

    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/general" android:title="General">
<CheckBoxPreference
            android:defaultValue="false"
            android:key="auto_connect_to_last_server"
            android:summary="@string/summary_auto_connect_to_last_server_preference"
            android:title="@string/title_auto_connect_to_last_server_preference"/>
<ListPreference
            android:dependency="auto_connect_to_last_server"
            android:defaultValue="10"
            android:dialogTitle="@string/dialog_title_auto_connect_delay_preference"
            android:entries="@array/entries_list_auto_connect_delay_preference"
            android:entryValues="@array/entryvalues_list_auto_connect_delay_preference"
            android:key="auto_connect_delay"
            android:summary="@string/summary_auto_connect_delay_preference"
            android:title="@string/title_auto_connect_delay_preference"/>
<CheckBoxPreference
            android:defaultValue="true"
            android:key="exit_on_standby"
            android:summary="@string/exit_on_standby_summary"
            android:title="@string/exit_on_standby_title" />
<Preference
            android:key="background_session_settings"
            android:summary="@string/background_session_settings_summary"
            android:title="@string/background_session_settings_title" />
<CheckBoxPreference
            android:defaultValue="true"
            android:key="disable_sleep"
            android:summary="@string/disable_sleep_summary"
            android:title="@string/disable_sleep_title" />
<CheckBoxPreference
            android:defaultValue="false"
            android:key="use_tv_ui_on_tablet"
            android:summary="@string/use_tv_ui_on_tablet_summary"
            android:title="@string/use_tv_ui_on_tablet_title"/>
<ListPreference
            android:defaultValue="128"
            android:dialogTitle="@string/dialog_title_list_mem_cache_preference"
            android:entries="@array/entries_list_mem_cache_preference"
            android:entryValues="@array/entryvalues_list_mem_cache_preference"
            android:key="image_cache_size_mb"
            android:summary="@string/summary_list_mem_cache_preference"
            android:title="@string/title_list_mem_cache_preference"/>
<ListPreference
            android:defaultValue="512"
            android:dialogTitle="@string/dialog_title_list_disk_cache_preference"
            android:entries="@array/entries_list_disk_cache_preference"
            android:entryValues="@array/entryvalues_list_disk_cache_preference"
            android:key="disk_image_cache_size_mb"
            android:summary="@string/summary_list_disk_cache_preference"
            android:title="@string/title_list_disk_cache_preference"/>
<Preference android:key="reset_to_defaults" android:title="Reset Settings to Defaults"
    android:summary="Confirmation required. Preserve servers, credentials, client ID, SMB mappings/profiles and files."/>
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>

    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/diagnostics" android:title="Diagnostics">
<Preference
            android:key="diagnostics_settings"
            android:summary="Automatic Push-stall capture, logging, diagnostic export, and SMB destination"
            android:title="Diagnostics Settings" />
<CheckBoxPreference
            android:key="client_diagnostics_web/enabled"
            android:defaultValue="false"
            android:title="Diagnostic web server"
            android:summary="View this Android device's redacted logs and statistics, or download a ZIP in a browser. Default off; foreground only. Trusted LAN only, no login/encryption." />
<EditTextPreference
            android:key="client_diagnostics_web/port"
            android:defaultValue="8272"
            android:title="Client diagnostic web port"
            android:summary="Port on this Android device, not the SageTV server (default 8272)" />
<Preference
            android:key="client_diagnostics_web/status"
            android:title="Diagnostic web address"
            android:selectable="false"
            android:summary="Off" />
<CheckBoxPreference
            android:key="server_diagnostics/enabled"
            android:defaultValue="false"
            android:title="Send diagnostic logs to server"
            android:summary="Separate from the client web server. Off by default; requires Client Extension's upload-only receiver. If unavailable, local logs and playback are unchanged." />
<EditTextPreference
            android:key="server_diagnostics/port"
            android:defaultValue="8272"
            android:title="Server diagnostic upload port"
            android:summary="Port of the separate server upload receiver, not the Android web server (default 8272)" />
<Preference
            android:key="server_diagnostics/upload_now"
            android:title="Upload diagnostic report now"
            android:summary="Enable server uploads first. Local logs are retained if the plugin is unavailable." />
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>

    <opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory android:key="settings/section/about" android:title="About">
<Preference
            android:key="version"
            android:summary=""
            android:title="Version"/>
<Preference
            android:key="versionCode"
            android:summary=""
            android:title="Version Code (Build Number)"/>
<Preference

            android:key="clientid"
            android:summary=""
            android:title="Client ID"/>
<Preference

            android:key="ipaddress"
            android:summary=""
            android:title="Device IP Address"/>
<Preference
            android:key="screensize"
            android:summary=""
            android:title="Native UI Resolution"/>
<Preference
            android:key="appmemory"
            android:summary=""
            android:title="Application Available Memory"/>
    </opensagetv.vibe.miniclient.android.ui.settings.CollapsiblePreferenceCategory>
</PreferenceScreen>
