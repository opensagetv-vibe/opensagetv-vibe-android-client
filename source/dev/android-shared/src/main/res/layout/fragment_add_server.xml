<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:context="opensagetv.vibe.miniclient.android.AddServerFragment"

                android:padding="20dp"
                android:theme="@style/Theme.AppCompat.Dialog">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="Server Name"
            android:id="@+id/lserver_name"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/server_name"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:nextFocusDown="@id/server_address"
            android:nextFocusForward="@id/server_address"
            android:singleLine="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="Server Address or Locator ID"
            android:id="@+id/textView"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/server_address"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:nextFocusDown="@id/button_ok"
            android:nextFocusForward="@id/button_ok"
            android:singleLine="true"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:id="@+id/button_ok"
            android:nextFocusUp="@id/server_address"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</RelativeLayout>
