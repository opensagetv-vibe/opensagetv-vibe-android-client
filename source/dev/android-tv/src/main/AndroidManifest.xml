<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false"/>

    <uses-feature
        android:name="com.google.android.tv"
        android:required="false"/>

    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false"/>

    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false"/>

    <!-- Tell the system this app requires OpenGL ES 3.0. -->
    <!--<uses-feature android:glEsVersion="0x00030000" android:required="false" />-->

    <!--<uses-feature android:name="android.hardware.opengles.aep" android:required="false" />-->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_v2"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:banner="@drawable/banner_v2"
        android:enableOnBackInvokedCallback="false"
        >

        <meta-data android:name="android.max_aspect" android:value="2.1" />

        <!-- ProfileInstaller is a transitive AndroidX optimization component,
             not a SageTV feature. Keep its library classes available to shared
             AndroidX code, but do not publish its initializer/receiver surface
             from this TV application. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                tools:node="remove" />
        </provider>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- API 36 migration safety: keep the established TV landscape/resizability behavior.
             This compatibility property is temporary and is not available when targeting API 37+. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- Vibe owns independent launcher implementation classes. This keeps
             it distinct from a separately installed legacy/JVL client at both
             the Android application-ID and component-class levels. -->
        <activity
            android:name="opensagetv.vibe.miniclient.android.phone.ServersActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.PhoneTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/banner_v2"
            android:icon="@drawable/banner_v2"
            android:label="@string/app_name"
            android:logo="@drawable/banner_v2"
            tools:replace="android:theme"
            android:theme="@style/Theme.Leanback.SageTV"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>
