# OPTIONAL WSL override.
# If omitted, the current project directory is mounted automatically.
# Example:
# OPENSAGETV_VIBE_ANDROID_ROOT=/mnt/c/source/opensagetv-vibe-android-client
OPENSAGETV_VIBE_ANDROID_ROOT=.

